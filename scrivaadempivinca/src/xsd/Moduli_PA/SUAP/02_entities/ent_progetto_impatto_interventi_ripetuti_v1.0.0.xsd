<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:epiirip="../02_entities/progetto_impatto_interventi_ripetuti"
    targetNamespace="../02_entities/progetto_impatto_interventi_ripetuti"
    elementFormDefault="qualified" attributeFormDefault="qualified"
    version="1.0.0" xml:lang="it">

    <xsd:complexType name="progetto_impatto_interventi_ripetuti_ctype">
        <xsd:sequence>
            <xsd:element name="impatto_non_pertinente" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="dati_progetto_impatto_interventi_ripetuti" minOccurs="0" maxOccurs="1">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="frequenza_periodica" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="desc_periodicita" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="provvedimento_precedente" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="desc_provvedimento_precedente" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="desc_motivo_ripetitivita" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="varianti_ripetizione" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="progetto_impatto_interventi_ripetuti" type="epiirip:progetto_impatto_interventi_ripetuti_ctype" />
</xsd:schema>
