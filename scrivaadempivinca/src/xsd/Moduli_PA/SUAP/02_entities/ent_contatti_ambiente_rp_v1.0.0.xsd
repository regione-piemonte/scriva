<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:econtambrp="../02_entities/contatti_ambiente_rp"
    xmlns:ctipi="../commons/tipi"
    targetNamespace="../02_entities/contatti_ambiente_rp"
    elementFormDefault="qualified" attributeFormDefault="qualified"
    version="1.0.0" xml:lang="it">

    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd" />

    <xsd:simpleType name="string_max_25_stype">
        <xsd:restriction base="xsd:string">
            <xsd:maxLength value="25" />
            <xsd:whiteSpace value="collapse" />
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="contatti_ambiente_rp_ctype">
        <xsd:sequence>
            <xsd:element name="telefono_fisso" type="econtambrp:string_max_25_stype" minOccurs="0" maxOccurs="1" />
            <xsd:element name="cellulare" type="econtambrp:string_max_25_stype" minOccurs="0" maxOccurs="1" />
            <xsd:element name="domicilio_digitale" type="ctipi:email_stype" minOccurs="1" maxOccurs="1" />
            <xsd:element name="email" type="ctipi:email_stype" minOccurs="1" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="contatti_ambiente_rp" type="econtambrp:contatti_ambiente_rp_ctype" />
</xsd:schema>
