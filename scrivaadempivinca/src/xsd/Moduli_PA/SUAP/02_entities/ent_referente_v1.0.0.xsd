<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:eref="../02_entities/referente"
  targetNamespace="../02_entities/referente"
  elementFormDefault="qualified" version="1.0.0" xml:lang="it">

  <xsd:complexType name="referente_ctype">
    <xsd:sequence>
      <xsd:element name="nome_referente" type="xsd:string" minOccurs="1" maxOccurs="1" />
      <xsd:element name="cognome_referente" type="xsd:string" minOccurs="1" maxOccurs="1" />
      <xsd:element name="mansione_referente" type="xsd:string" minOccurs="0" maxOccurs="1" />
    </xsd:sequence>
  </xsd:complexType>

  <xsd:element name="referente" type="eref:referente_ctype" />

</xsd:schema>
