<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:epiman="../02_entities/progetto_impatto_manifestazioni"
    targetNamespace="../02_entities/progetto_impatto_manifestazioni"
    elementFormDefault="qualified" attributeFormDefault="qualified"
    version="1.0.0" xml:lang="it">

    <xsd:simpleType name="non_empty_string_stype">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:whiteSpace value="collapse"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="progetto_impatto_manifestazioni_ctype">
        <xsd:sequence>
            <xsd:element name="impatto_non_pertinente" type="xsd:boolean" minOccurs="1" maxOccurs="1" />
            <xsd:element name="dati_progetto_impatto_manifestazioni" minOccurs="0" maxOccurs="1">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="num_partecipanti" type="epiman:non_empty_string_stype" minOccurs="1" maxOccurs="1" />
                        <xsd:element name="num_tipologia_veicoli" type="epiman:non_empty_string_stype" minOccurs="1" maxOccurs="1" />
                        <xsd:element name="num_tipologia_mezzi_supporto" type="epiman:non_empty_string_stype" minOccurs="1" maxOccurs="1" />
                        <xsd:element name="strutture_supporto" type="epiman:non_empty_string_stype" minOccurs="1" maxOccurs="1" />
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="progetto_impatto_manifestazioni" type="epiman:progetto_impatto_manifestazioni_ctype" />
</xsd:schema>
