<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:episv="../02_entities/progetto_impatto_specie_vegetali"
    targetNamespace="../02_entities/progetto_impatto_specie_vegetali"
    elementFormDefault="qualified" attributeFormDefault="qualified"
    version="1.0.0" xml:lang="it">

    <xsd:complexType name="progetto_impatto_specie_vegetali_ctype">
        <xsd:sequence>
            <xsd:element name="impatto_specie_vegetali_non_pertinente" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="dati_progetto_impatto_specie_vegetali" minOccurs="0" maxOccurs="1">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="taglio_specie_vegetali" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="desc_taglio_specie_vegetali" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="piantumazione_specie_vegetali" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="desc_piantumazione_specie_vegetali" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="conforme_normativa_specie_vegetali" type="xsd:boolean" minOccurs="1" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="progetto_impatto_specie_vegetali" type="episv:progetto_impatto_specie_vegetali_ctype" />
</xsd:schema>
